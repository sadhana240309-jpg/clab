#include <iostream>
#include <cstring>
#include <chrono>
#include <utility>
using namespace std;
using namespace chrono;

class String
{
private:
    char* strData;    // Modified: data -> strData
    size_t strLen;    // Modified: length -> strLen

public:
    // Constructor
    String(const char* txt = "") // Modified: str -> txt
    {
        strLen = strlen(txt);
        strData = new char[strLen + 1];
        strcpy(strData, txt);
    }

    // Copy Constructor - deep copy
    String(const String& src) // Modified: other -> src
    {
        strLen = src.strLen;
        strData = new char[strLen + 1];
        strcpy(strData, src.strData);
    }

    // Move Constructor - transfer ownership
    String(String&& src) noexcept // Modified: other -> src
    {
        strData = src.strData;
        strLen = src.strLen;

        src.strData = nullptr;
        src.strLen = 0;
    }

    // Copy Assignment Operator
    String& operator=(const String& src)
    {
        if (this != &src)
        {
            delete[] strData;

            strLen = src.strLen;
            strData = new char[strLen + 1];
            strcpy(strData, src.strData);
        }
        return *this;
    }

    // Move Assignment Operator
    String& operator=(String&& src) noexcept
    {
        if (this != &src)
        {
            delete[] strData;

            strData = src.strData;
            strLen = src.strLen;

            src.strData = nullptr;
            src.strLen = 0;
        }
        return *this;
    }

    // Destructor
    ~String()
    {
        delete[] strData;
    }

    void display() const
    {
        if (strData != nullptr)
            cout << strData << endl;
    }
};

// Perfect Forwarding Function - Name kept same
template <typename T>
String createString(T&& val) // Modified: value -> val
{
    return String(forward<T>(val));
}

