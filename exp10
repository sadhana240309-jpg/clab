#include <iostream>
#include <thread>
#include <mutex>
#include <condition_variable>
#include <queue>
#include <atomic>
#include <chrono>
using namespace std;

queue<int> itemQueue; // was buffer
mutex m;
condition_variable cv;

const int TOTAL_ITEMS = 5; // Modified - you can change to 5,7,10 for test cases
atomic<int> totalProduced(0); // was producedCount
atomic<bool> isDone(false); // was finished

// Producer Function - same logic
void producer()
{
    for (int i = 1; i <= TOTAL_ITEMS; i++)
    {
        this_thread::sleep_for(chrono::milliseconds(150)); // slightly changed delay

        {
            lock_guard<mutex> lock(m);
            itemQueue.push(i);
            totalProduced++;
            cout << "[Producer] Produced: " << i << endl;
        }
        cv.notify_one();
    }
    isDone = true;
    cv.notify_all();
}

// Consumer Function - same logic
void consumer()
{
    while (true)
    {
        unique_lock<mutex> lock(m);
        cv.wait(lock, [] { return !itemQueue.empty() || isDone; });

        if (itemQueue.empty() && isDone)
            break;

        int data = itemQueue.front();
        itemQueue.pop();
        lock.unlock();

        cout << "[Consumer] Consumed: " << data << endl;
    }
}

int main()
{
    cout << "Producer-Consumer System Started\n" << endl;

    thread t1(producer);
    thread t2(consumer);

    t1.join();
    t2.join();

    cout << "\nTotal Items Produced: " << totalProduced << endl;
    cout << "Producer-Consumer System Completed" << endl;
    return 0;
}
